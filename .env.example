# Copy to orchestrator/.env and dashboard/.env.local. Never commit the real files.

# Shared bearer token between the dashboard's server side and the orchestrator.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHANTOM_API_TOKEN=

# --- orchestrator ---
PHANTOM_HOST=127.0.0.1
PHANTOM_PORT=8400
# simulated = dry run, no containers.  docker = real containers via the Docker SDK.
PHANTOM_RUNTIME=simulated
PHANTOM_TIME_SCALE=1
PHANTOM_MAX_SESSIONS=6
PHANTOM_SESSION_TTL_SECONDS=900
# Optional: keep honeytokens attributable across restarts.
# PHANTOM_CANARY_KEY=
# Optional: write the evidence ledger to disk as JSON lines.
# PHANTOM_DATA_DIR=./data

# --- dashboard ---
PHANTOM_API_URL=http://127.0.0.1:8400
